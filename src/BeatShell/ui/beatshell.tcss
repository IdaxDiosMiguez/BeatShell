/* BeatShell — estilos
   Principios: pocas líneas, mucho aire, un solo color de acento por estado. */

Screen {
    background: $background;
}

/* ---------------------------------------------------------- cabecera */
#top {
    height: 3;
    padding: 0 2;
    background: $background;
}
#top Logo {
    margin-right: 3;
}
#omnibar {
    width: 1fr;
    height: 3;
    border: tall $panel;
    background: $surface;
    padding: 0 1;
}
#omnibar:focus {
    border: tall $primary;
}

/* ---------------------------------------------------------- cuerpo */
#body {
    height: 1fr;
    margin-top: 1;
}
#sidebar {
    width: 22;
    background: $surface;
    padding: 1 0;
}
#nav {
    height: auto;
    background: $surface;
    border: none;
    padding: 0;
}
#nav > .option-list--option {
    padding: 0 2;
}
#nav:focus {
    border: none;
}
#sidebar-stats {
    dock: bottom;
    height: auto;
    padding: 0 2;
    color: $text-muted;
}
#views {
    width: 1fr;
    padding: 0 2;
}
.view-header {
    height: auto;
    padding: 0 1;
    text-style: bold;
    color: $foreground;
}
.view-hint {
    height: auto;
    padding: 0 1 1 1;
    color: $text-muted;
}
.split {
    height: 1fr;
}
.side-list {
    width: 34;
    height: 1fr;
    background: $surface;
    border: none;
    padding: 1 1;
    margin-right: 2;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}
.side-list:focus {
    background-tint: $primary 4%;
}
#lib-tree > .tree--cursor {
    background: $primary 30%;
    text-style: bold;
}
#lib-tree:focus > .tree--cursor {
    background: $primary 55%;
}
#lib-tree > .tree--guides {
    color: $panel;
}
#library-filter {
    height: 3;
    border: tall $panel;
    background: $surface;
    margin-bottom: 1;
}
#library-filter:focus {
    border: tall $secondary;
}

TrackTable, #downloads-table {
    height: 1fr;
    background: $background;
    border: none;
    scrollbar-size-vertical: 1;
}
TrackTable > .datatable--header, #downloads-table > .datatable--header {
    background: $background;
    color: $text-muted;
    text-style: bold;
}
TrackTable > .datatable--cursor, #downloads-table > .datatable--cursor {
    background: $primary 25%;
    color: $foreground;
}
TrackTable:focus > .datatable--cursor, #downloads-table:focus > .datatable--cursor {
    background: $primary 55%;
    text-style: bold;
}
TrackTable > .datatable--even-row, #downloads-table > .datatable--even-row {
    background: $surface 45%;
}
TrackTable > .datatable--hover, #downloads-table > .datatable--hover {
    background: $primary 12%;
}

LoadingIndicator {
    color: $primary;
    height: 3;
}

/* ---------------------------------------------------------- reproductor */
#player {
    height: 12;
    background: $surface;
    padding: 1 2;
    margin-top: 1;
}
#player CoverArt {
    width: 22;
    height: 10;
    margin-right: 3;
}
#player-main {
    width: 1fr;
}
#now {
    height: 2;
}
#now-text {
    width: 1fr;
}
#now-title {
    height: 1;
    width: 100%;
    text-style: bold;
    color: $foreground;
}
#now-sub {
    height: 1;
    width: 100%;
    color: $secondary;
}
#now-badges {
    width: auto;
    height: 1;
    link-style: none;
    link-background-hover: $primary 25%;
}
#player Visualizer {
    height: 1fr;
    margin: 1 0 0 0;
}
#player SeekBar {
    margin-top: 1;
}
#controls-row {
    height: 1;
}
#controls {
    width: auto;
    height: 1;
    link-style: none;
    link-background-hover: $primary 25%;
}
#now-status {
    width: 1fr;
    height: 1;
    color: $text-muted;
    text-align: right;
}

/* Terminal bajita: reproductor compacto */
Screen.-compact #player {
    height: 7;
    padding: 0 2;
}
Screen.-compact #player CoverArt {
    width: 12;
    height: 6;
    margin-right: 2;
}
Screen.-compact #player Visualizer {
    height: 1;
    margin: 0;
}
Screen.-compact #player SeekBar {
    margin-top: 0;
}
Screen.-compact #top Logo {
    display: none;
}
Screen.-compact #body, Screen.-compact #player {
    margin-top: 0;
}
Screen.-narrow #sidebar {
    display: none;
}

/* ---------------------------------------------------------- diálogos */
ModalScreen {
    align: center middle;
    background: $background 70%;
}
.dialog {
    width: 66;
    height: auto;
    max-height: 90%;
    border: tall $primary;
    background: $surface;
    padding: 1 3;
}
.dialog.help {
    width: 86;
    height: 90%;
}
.dialog.eq {
    width: 84;
}
.eq-body {
    height: auto;
}
#eq-presets {
    width: 22;
    height: 15;
    border: none;
    background: $background;
    margin-right: 3;
}
.eq-side {
    width: 1fr;
    height: auto;
}
.dialog-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    width: 100%;
}
.dialog-hint {
    color: $text-muted;
    margin-top: 1;
    width: 100%;
}
.dialog-buttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}
.dialog-buttons Button {
    margin-left: 1;
}
.dialog Input {
    border: tall $panel;
    background: $background;
}
.dialog Input:focus {
    border: tall $secondary;
}
#picker {
    height: auto;
    max-height: 18;
    border: none;
    background: $background;
}
.help-title {
    color: $secondary;
    text-style: bold;
    margin-top: 1;
}

Footer {
    background: $surface;
}
